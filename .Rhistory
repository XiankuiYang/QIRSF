# Step 0: Create the data
seeded <- data.frame(
x = c(24, 28, 30, 37, 43, 47, 52, 57, 71, 87, 115),
y = c(0.180, 0.175, 0.178, 0.021, 0.260, 0.715, 0.441, 0.205, 0.417, 0.498, 0.603)
)
control <- data.frame(
x = c(-7, 10, 17, 25, 44, 51, 53, 65, 75, 90),
y = c(0.138, 0.081, 0.072, 0.188, 0.075, 0.435, 0.423, 0.339, 0.519, 0.738)
)
# Step 1: Means of x
x1_bar <- mean(seeded$x)
x2_bar <- mean(control$x)
# Step 2: Numerator and Denominator for pooled slope
numerator <- sum((seeded$x - x1_bar) * seeded$y) + sum((control$x - x2_bar) * control$y)
denominator <- sum((seeded$x - x1_bar)^2) + sum((control$x - x2_bar)^2)
# Step 3: Pooled slope
beta_bar <- numerator / denominator
# Step 4: Aligned values: y_star = y - beta_bar * x
seeded$y_star <- seeded$y - beta_bar * seeded$x
control$y_star <- control$y - beta_bar * control$x
# Step 5: Rank aligned values within each group
seeded$rank <- rank(seeded$y_star, ties.method = "average")
control$rank <- rank(control$y_star, ties.method = "average")
# Step 6: Compute T* and C^2 for each group
n1 <- nrow(seeded)
n2 <- nrow(control)
T1_star <- sum((seeded$x - x1_bar) * seeded$rank) / (n1 + 1)
T2_star <- sum((control$x - x2_bar) * control$rank) / (n2 + 1)
C1_sq <- sum((seeded$x - x1_bar)^2)
C2_sq <- sum((control$x - x2_bar)^2)
# Step 7: Sen–Adichie test statistic V
V <- 12 * ((T1_star^2) / C1_sq + (T2_star^2) / C2_sq)
# Step 8: Compare with critical value
alpha <- 0.05
critical_value <- qchisq(1 - alpha, df = 1)
# Step 9: Print results
cat("Pooled slope beta_bar =", beta_bar, "\n")
cat("T1* =", T1_star, ", T2* =", T2_star, "\n")
cat("C1^2 =", C1_sq, ", C2^2 =", C2_sq, "\n")
cat("Sen–Adichie test statistic V =", V, "\n")
cat("Critical value at alpha = 0.05:", critical_value, "\n")
if (V >= critical_value) {
cat("Reject H0: Regression lines are NOT parallel\n")
} else {
cat("Fail to reject H0: Regression lines may be parallel\n")
}
control$rank
